[
  {"id": "R1", "group": "R", "text": "Tự mua và lắp ráp máy vi tính theo ý mình.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R2", "group": "R", "text": "Lắp ráp tủ theo hướng dẫn của sách hướng dẫn hoặc trang mạng.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R3", "group": "R", "text": "Trang điểm cho mình hay cho bạn theo hướng dẫn của sách hướng dẫn hoặc trang mạng.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R4", "group": "R", "text": "Cắt tỉa cây cảnh.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R5", "group": "R", "text": "Tháo mở điện thoại di động hay máy tính ra để tìm hiểu.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R6", "group": "R", "text": "Tham gia một chuyến du lịch thám hiểm (như khám phá hang động, núi rừng).", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R7", "group": "R", "text": "Chăm sóc vật nuôi.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R8", "group": "R", "text": "Sửa xe, như xe đạp, xe máy (các lỗi nhỏ).", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R9", "group": "R", "text": "Làm đồ nội thất.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R10", "group": "R", "text": "Lắp ráp máy vi tính.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R11", "group": "R", "text": "Leo núi.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R12", "group": "R", "text": "Đóng gói đồ đạc vào thùng.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R13", "group": "R", "text": "Chơi một môn thể thao.", "dimension": "Realistic", "source": "Huong Nghiep Song An"},
  {"id": "R14", "group": "R", "text": "Tham gia chuyến đạp xe xuyên quốc gia (từ TPHCM ra Hà Nội, từ Hà Nội vào TPHCM).", "dimension": "Realistic", "source": "Huong Nghiep Song An"},

  {"id": "I1", "group": "I", "text": "Tham quan bảo tàng.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I2", "group": "I", "text": "Tìm hiểu sự hình thành của các vì sao và vũ trụ.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I3", "group": "I", "text": "Tìm hiểu về văn hóa một quốc gia mà mình thích.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I4", "group": "I", "text": "Tìm hiểu về tâm lý con người.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I5", "group": "I", "text": "Đọc một cuốn sách về tương lai của loài người trong một triệu năm nữa.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I6", "group": "I", "text": "Đọc sách, báo hay xem trang tin tức về khoa học.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I7", "group": "I", "text": "Tìm hiểu về cảm xúc con người.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I8", "group": "I", "text": "Được xem một ca mổ tim.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I9", "group": "I", "text": "Tìm hiểu nguồn gốc của một dịch bệnh, nguồn gốc loài người, v.v.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I10", "group": "I", "text": "Đọc các bài báo về ảnh hưởng của AI (trí tuệ nhân tạo) lên nghề nghiệp tương lai.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I11", "group": "I", "text": "Tìm hiểu về thế giới động vật (qua các kênh tìm hiểu khoa học).", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I12", "group": "I", "text": "Phát minh xe điện.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I13", "group": "I", "text": "Tiến hành thí nghiệm hóa học.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},
  {"id": "I14", "group": "I", "text": "Nghiên cứu về chế độ dinh dưỡng.", "dimension": "Investigative", "source": "Huong Nghiep Song An"},

  {"id": "A1", "group": "A", "text": "Tạo ra một tác phẩm nghệ thuật, tranh, câu chuyện.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A2", "group": "A", "text": "Viết truyện ngắn.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A3", "group": "A", "text": "Chứng tỏ năng lực nghệ thuật của bản thân với người khác (nói lên suy nghĩ/quan điểm qua tác phẩm nghệ thuật).", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A4", "group": "A", "text": "Chơi trong một ban nhạc.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A5", "group": "A", "text": "Chỉnh sửa phim.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A6", "group": "A", "text": "Thuyết trình hoặc thiết kế, theo ý tưởng của mình.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A7", "group": "A", "text": "Vẽ phim hoạt hình.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A8", "group": "A", "text": "Hát trong một ban nhạc.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A9", "group": "A", "text": "Biểu diễn nhảy hiện đại.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A10", "group": "A", "text": "Dẫn chương trình (MC) cho một sự kiện.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A11", "group": "A", "text": "Độc thoại hay kể chuyện trên đài phát thanh/phần mềm.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A12", "group": "A", "text": "Viết kịch bản cho phim hoặc chương trình truyền hình.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A13", "group": "A", "text": "Chụp ảnh cho các sự kiện trong cuộc sống hoặc sự kiện nghệ thuật.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},
  {"id": "A14", "group": "A", "text": "Viết một bài phê bình phim cho bộ phim mình thích/ghét nhất.", "dimension": "Artistic", "source": "Huong Nghiep Song An"},

  {"id": "S1", "group": "S", "text": "Giúp người khác chọn nghề nghiệp phù hợp.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S2", "group": "S", "text": "Kết nối hai người bạn với nhau.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S3", "group": "S", "text": "Dạy cho bạn mình cách giảm cân qua ăn uống đúng cách.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S4", "group": "S", "text": "Tham gia ngày trái đất bằng cách lượm rác hay tắt điện.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S5", "group": "S", "text": "Hướng dẫn khách nước ngoài chỗ ăn ngon.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S6", "group": "S", "text": "Cứu động vật bị bỏ rơi ngoài đường.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S7", "group": "S", "text": "Tham gia vào một cuộc thảo luận nhóm nhỏ.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S8", "group": "S", "text": "Kể chuyện cười cho bạn bè nghe.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S9", "group": "S", "text": "Dạy em nhỏ chơi một trò chơi hay một môn thể thao.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S10", "group": "S", "text": "Lắng nghe bạn bè tâm sự về vấn đề cá nhân của họ.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S11", "group": "S", "text": "Giúp bạn bè giải quyết vấn đề liên quan đến tình yêu.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S12", "group": "S", "text": "Tham gia một chuyến đi từ thiện.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S13", "group": "S", "text": "Giúp một dự án cộng đồng trong sức của mình.", "dimension": "Social", "source": "Huong Nghiep Song An"},
  {"id": "S14", "group": "S", "text": "Sẵn sàng giúp thầy cô, bạn bè khi thấy họ cần.", "dimension": "Social", "source": "Huong Nghiep Song An"},

  {"id": "E1", "group": "E", "text": "Tham gia ban đại diện học sinh ở trường.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E2", "group": "E", "text": "Làm cán bộ lớp.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E3", "group": "E", "text": "Bán hàng trực tuyến.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E4", "group": "E", "text": "Quản lý một cửa hàng trực tuyến.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E5", "group": "E", "text": "Học về thị trường chứng khoán (bitcoin, cổ phiếu, tiền tệ, v.v.).", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E6", "group": "E", "text": "Tham gia một khóa học về quản lý tài chính.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E7", "group": "E", "text": "Tham dự một trại huấn luyện kỹ năng lãnh đạo dành cho lứa tuổi thanh thiếu niên.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E8", "group": "E", "text": "Lập kế hoạch làm việc cho thành viên nhóm.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E9", "group": "E", "text": "Kiếm tiền bằng cách kinh doanh trực tuyến.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E10", "group": "E", "text": "Nói trước đám đông về một đề tài mình thích.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E11", "group": "E", "text": "Tham gia xây dựng các luật lệ mới cho lớp/trường.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E12", "group": "E", "text": "Thuyết phục cha mẹ theo ý mình.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E13", "group": "E", "text": "Tổ chức đi chơi cho một nhóm bạn.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},
  {"id": "E14", "group": "E", "text": "Kiếm tiền bằng cách làm thêm.", "dimension": "Enterprising", "source": "Huong Nghiep Song An"},

  {"id": "C1", "group": "C", "text": "Mở tài khoản tiết kiệm.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C2", "group": "C", "text": "Lập kế hoạch chi tiêu hàng tháng.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C3", "group": "C", "text": "Chuẩn bị ngân sách cho chuyến đi chơi tập thể lớp.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C4", "group": "C", "text": "Chuẩn bị cho buổi trình bày trước lớp.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C5", "group": "C", "text": "Lập kế hoạch cho kỳ nghỉ hè/Tết.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C6", "group": "C", "text": "Đếm và sắp xếp tiền.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C7", "group": "C", "text": "Sắp xếp lại bàn học.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C8", "group": "C", "text": "Viết kế hoạch học tập cho học kỳ mới.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C9", "group": "C", "text": "Hoàn tất bài tập theo đúng hạn được giao.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C10", "group": "C", "text": "Dò lỗi chính tả cho phụ đề của một phim ưa thích.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C11", "group": "C", "text": "Học một khóa vi tính văn phòng và biết cách sắp xếp văn bản, thư mục sao cho chỉn chu.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C12", "group": "C", "text": "Làm thủ quỹ cho lớp.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C13", "group": "C", "text": "Sắp xếp lại tủ quần áo cá nhân.", "dimension": "Conventional", "source": "Huong Nghiep Song An"},
  {"id": "C14", "group": "C", "text": "Giúp ba/mẹ quản lý tiền chợ của gia đình (mua gì, mua khi nào, mua bao nhiêu).", "dimension": "Conventional", "source": "Huong Nghiep Song An"},

  {"id": "CHK1", "group": "CHECK", "text": "Đây là câu kiểm tra mức độ tập trung: Vui lòng chọn mức 4 (Thích) cho câu này.", "dimension": "AttentionCheck", "source": "System"}
]
